{
  "name": "payment-processed-message-outbox-source-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "payment-stub-postgres",
    "database.port": "5432",
    "database.user": "payment_stub_db_user",
    "database.password": "payment_stub_db_user_password",
    "database.dbname": "payment_stub_db",
    "database.server.name": "postgres",
    "table.include.list": "public.payment_processed_message_outbox",
    "topic.prefix": "db.payment",
    "transforms": "Unwrap,SetSchemaMetadataKey,SetSchemaMetadataValue,ConvertCreatedTimestamp,ConvertFinishedTimestamp,Route",
    "transforms.Unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.Unwrap.drop.tombstones": "false",
    "transforms.SetSchemaMetadataKey.type": "org.apache.kafka.connect.transforms.SetSchemaMetadata$Key",
    "transforms.SetSchemaMetadataKey.schema.name": "ru.otus.courses.java.advanced.shooter.server.payment.outbox.ProcessedPaymentMessageKey",
    "transforms.SetSchemaMetadataValue.type": "org.apache.kafka.connect.transforms.SetSchemaMetadata$Value",
    "transforms.SetSchemaMetadataValue.schema.name": "ru.otus.courses.java.advanced.shooter.server.payment.outbox.ProcessedPaymentMessage",
    "transforms.ConvertCreatedTimestamp.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.ConvertCreatedTimestamp.target.type": "Timestamp",
    "transforms.ConvertCreatedTimestamp.field": "created_timestamp",
    "transforms.ConvertCreatedTimestamp.format": "yyyy-MM-dd'T'HH:mm:ss.SSSSSS'Z'",
    "transforms.ConvertFinishedTimestamp.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.ConvertFinishedTimestamp.target.type": "Timestamp",
    "transforms.ConvertFinishedTimestamp.field": "processing_finished_timestamp",
    "transforms.ConvertFinishedTimestamp.format": "yyyy-MM-dd'T'HH:mm:ss.SSSSSS'Z'",
    "transforms.Route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.Route.regex": "db\\.payment\\.public\\.payment_processed_message_outbox",
    "transforms.Route.replacement": "db.payment.public.payment_processed_message_outbox_v2",
    "topic.creation.default.partitions": 3,
    "topic.creation.default.replication.factor": 8,
    "plugin.name": "pgoutput",
    "message.key.columns": "public.product_trade_issuance_performed_message_outbox:uuid",
    "tasks.max": "1"
  }
}

