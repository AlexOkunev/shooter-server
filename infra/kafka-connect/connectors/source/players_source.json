{
  "name": "players-source-connector-v2",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "players-postgres",
    "database.port": "5432",
    "database.user": "players_db_user",
    "database.password": "players_db_user_password",
    "database.dbname": "players_db",
    "database.server.name": "postgres",
    "table.include.list": "public.player",
    "topic.prefix": "db",
    "transforms": "unwrap,DropKeycloakId,SetSchemaMetadataKey,SetSchemaMetadataValue,ConvertCreatedTimestamp",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.add.headers": "op,ts_ms",
    "transforms.DropKeycloakId.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
    "transforms.DropKeycloakId.exclude": "keycloak_id",
    "transforms.SetSchemaMetadataKey.type": "org.apache.kafka.connect.transforms.SetSchemaMetadata$Key",
    "transforms.SetSchemaMetadataKey.schema.name": "ru.otus.courses.java.advanced.shooter.server.players.kafka.types.PlayerKey",
    "transforms.SetSchemaMetadataValue.type": "org.apache.kafka.connect.transforms.SetSchemaMetadata$Value",
    "transforms.SetSchemaMetadataValue.schema.name": "ru.otus.courses.java.advanced.shooter.server.players.kafka.types.Player",
    "transforms.ConvertCreatedTimestamp.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.ConvertCreatedTimestamp.target.type": "Timestamp",
    "transforms.ConvertCreatedTimestamp.field": "created_timestamp",
    "transforms.ConvertCreatedTimestamp.format": "yyyy-MM-dd'T'HH:mm:ss.SSSSSS'Z'",
    "topic.creation.default.partitions": 4,
    "topic.creation.default.replication.factor": 3,
    "plugin.name": "pgoutput",
    "message.key.columns": "public.player:player_uuid",
    "tasks.max": "1"
  }
}