<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>[%date] %magenta([%thread]) %highlight([%level]) %cyan([%logger{36}]) %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="ru.otus.courses.java" level="debug" additivity="false">
    <appender-ref ref="STDOUT"/>
  </logger>

  <root level="info">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>